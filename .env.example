# Copy to .env (gitignored) and fill in. Every setting has a safe local default; see server/app/core/config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Matches docker-compose.yml (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://tailor:tailor@localhost:5433/tailor

# Sign-in tokens. Locally: dev tokens from `.venv/Scripts/python.exe -m app.cli.dev_token --email you@example.com`.
# Staging/production must use AUTH_MODE=jwks (the app refuses to start with dev tokens there).
AUTH_MODE=dev
# AUTH_DEV_SECRET=<any long random string; optional locally>
# AUTH_JWKS_URL=https://app.example.com/api/auth/jwks
# AUTH_ISSUER=https://app.example.com
# AUTH_AUDIENCE=tailor-api

# Groq (Developer-tier key from console.groq.com). Put the real value in .env, never in this file.
GROQ_API_KEY=
# LLM_RUN_BUDGET_USD=0.5
# LLM_MAX_CONCURRENCY=8
