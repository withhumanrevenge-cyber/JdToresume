{
  "name": "@tailor/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from the FastAPI OpenAPI schema. Never edit src/schema.d.ts by hand.",
  "type": "module",
  "types": "./src/schema.d.ts",
  "exports": {
    ".": {
      "types": "./src/schema.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json --output ./src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
